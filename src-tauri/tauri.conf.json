{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoeMusicPlayer",
  "version": "0.1.0",
  "identifier": "com.moemusicplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1450",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MoeMusicPlayer",
        "width": 1360,
        "height": 900,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
