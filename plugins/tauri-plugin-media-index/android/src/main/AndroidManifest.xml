<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 10 and older. Android 11+ scans and edits shared music via MANAGE_EXTERNAL_STORAGE (ADR 0014). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+: the Media3 media notification (shade + lock screen) needs this runtime grant. -->
    <!-- Only requested when the user picks the system wallpaper and the system refuses to hand it over without this (HyperOS). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app update (ADR 0015): hand a downloaded, SHA-256-verified APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Floating lyrics (ADR 0032): granted by the user in the system settings page, never by the app. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 「附近的裝置」 (Android 12+): the Bluetooth codec of the output devices (ADR 0044); asked for only after the
         explanation panel of Settings → playback. Not used to scan for or connect to devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application>
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Own subclass so the merged manifest never collides with another androidx FileProvider. -->
        <provider
            android:name=".MoeUpdateFileProvider"
            android:authorities="${applicationId}.moe.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/moe_update_paths" />
        </provider>
    </application>
</manifest>
